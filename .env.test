DATABASE_URL="mysql://root:@localhost:3306/geest_api_test"
PORT=3001

# Los tests levantan su propio webhook y sobreescriben NOTIFY_URL en caliente.
NOTIFY_URL=""

# Backoff diminuto: en tests no tiene sentido esperar 1s y 2s reales.
NOTIFY_RETRY_BASE_MS=10
NOTIFY_TIMEOUT_MS=300
# Corto a propósito: hay un test que verifica el timeout IDEMPOTENCY_IN_PROGRESS
# y con 8s la suite se alargaría sin ganar nada.
IDEMPOTENCY_WAIT_MS=2000
