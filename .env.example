# Copiar a .env y ajustar. El .env real nunca se sube al repositorio.

# Conexión a MySQL
DATABASE_URL="mysql://usuario:password@localhost:3306/geest_api"

# Puerto HTTP de la API
PORT=3000

# Destino del webhook que se notifica al archivar una tarea.
# Para probar en local: crear una URL desechable en https://webhook.site
NOTIFY_URL="https://webhook.site/tu-uuid-aqui"

# --- Opcionales (valores por defecto entre paréntesis) ---

# Espera base del backoff exponencial de reintentos: 1s, 2s (1000)
NOTIFY_RETRY_BASE_MS=1000

# Tiempo máximo de espera por cada intento de notificación (5000)
NOTIFY_TIMEOUT_MS=5000

# Cuánto espera un request duplicado a que el original termine (8000)
IDEMPOTENCY_WAIT_MS=8000
